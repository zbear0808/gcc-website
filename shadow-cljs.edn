{:deps   {:aliases [:dev]} 
 :builds {:app {:target           :browser
                :output-dir       "public/js"
                :asset-path       "/js"
                :devtools         {:http-port 5000
                                   :http-root "public"
                                   :push-state true
                                   :preloads [dev.refresh]
                                   :reload-strategy :full}
                :modules          {:main {:init-fn main.app/init}}
                :compiler-options {:install-deps true}}
 
          :tests {:target    :browser-test
                  :test-dir  "out/tests"
                  :ns-regexp "-test$"
                  :devtools  {:http-port 5001
                              :http-root "out/tests"}}
          
          :node-tests {:target    :node-test
                       :main      node/main
                       :output-to "out/node-tests.js"}
                       
          :server {:target :node-library
                   :exports {:handler server.core/handler}
                   :output-to "api/index.js"}}}
