# Environment variables for GCC Shop
# Copy this to .env and fill in your values

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Upstash Redis (optional — set USE_FALLBACK_INVENTORY=true to skip)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Inventory fallback (set to "true" to use in-memory stock of 10 per item)
USE_FALLBACK_INVENTORY=true

# Admin API protection
ADMIN_SECRET=

# Vite frontend — URL to the Vercel API deployment
# In production on Render, set this to your Vercel deployment URL (e.g. https://gcc-api.vercel.app)
# Locally, leave empty to use the Vite proxy (/api -> localhost:3000)
VITE_API_URL=
