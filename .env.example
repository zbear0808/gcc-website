# Environment variables for GCC Shop
# Copy this to .env and fill in your values

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_me

# Upstash Redis credentials (provisioned via Vercel KV) — required for checkout order storage and inventory
KV_REST_API_READ_ONLY_TOKEN="replace_me"
KV_REST_API_TOKEN="replace_me"
KV_REST_API_URL="https://replace-me.upstash.io"
KV_URL="rediss://default:replace_me@replace-me.upstash.io:6379"
REDIS_URL="rediss://default:replace_me@replace-me.upstash.io:6379"

# Inventory fallback (set to "true" to use in-memory stock of 10 per item)
USE_FALLBACK_INVENTORY=true

# Admin API protection
ADMIN_SECRET=

# Vite frontend — URL to the Vercel API deployment
# In production on Render, set this to your Vercel deployment URL (e.g. https://gcc-api.vercel.app)
# Locally, leave empty to use the Vite proxy (/api -> localhost:3000)
VITE_API_URL=

# EasyPost
EASYPOST_API_KEY="replace_me"
SHIPPING_ORIGIN_ZIP=98122
